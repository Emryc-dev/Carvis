# FastAPI application
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Supabase PostgreSQL (server-only)
# Runtime transaction pooler for FastAPI and SQLAlchemy:
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Direct connection for Alembic migrations:
DIRECT_URL=postgresql+asyncpg://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase Auth and Storage
# The publishable key belongs in Flutter; SQLAlchemy does not use it.
# The secret key is backend-only and must never be shipped in Flutter.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=vehicle-scans

# Upstash Redis (server-only)
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# Gemini (server-only)
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash

# Image validation and external-service timeout
MAX_IMAGE_BYTES=10485760
MIN_IMAGE_WIDTH=224
MIN_IMAGE_HEIGHT=224
MAX_IMAGE_DIMENSION=12000
AI_TIMEOUT_SECONDS=45
